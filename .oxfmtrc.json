{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"endOfLine": "lf",
	"printWidth": 80,
	"svelte": true,
	"sortImports": false,
	"sortPackageJson": false,
	"ignorePatterns": [
		"content/**",
		"generated/**",
		"static/**",
		"**/package-lock.json"
	],
	"overrides": [
		{
			"files": [
				"src/lib/editor/ui/**/*.svelte",
				"src/lib/ui/kit/**/*.svelte",
				"tests/ui/**/*.svelte"
			],
			"options": {
				"htmlWhitespaceSensitivity": "ignore"
			}
		}
	]
}
