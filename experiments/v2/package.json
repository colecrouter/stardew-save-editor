{
	"name": "stardew-v2-mutation-experiment",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "node --test mutation.node.ts && vitest run --config vitest.config.ts",
		"test:node": "node --test mutation.node.ts",
		"demo": "node run.ts",
		"demo:platform": "node platform-run.ts",
		"measure:bundle": "node measure-bundle.ts",
		"lab": "npm run sync --prefix ../.. && vite --config vite.lab.config.ts",
		"lab:build": "npm run sync --prefix ../.. && vite build --config vite.lab.config.ts",
		"check:ui": "svelte-check --workspace . --tsconfig tsconfig.lab.json",
		"check": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
		"effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.6",
		"bits-ui": "2.20.2",
		"effect": "4.0.6"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.6",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.0.0",
		"svelte": "5.55.7",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
