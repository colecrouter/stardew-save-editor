{
	"name": "stardew-save-editor",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.app.json --watch",
		"dump": "dotnet run --project tools/xnbhack/AssetDump.csproj",
		"test:asset-dump": "dotnet run --project tools/xnbhack/tests/WorkspaceTests.csproj",
		"check": "npm run lint && npm run check:types && npm run check:tests && npm run check:tooling && svelte-check --tsgo --tsconfig ./tsconfig.app.json",
		"format": "vp fmt --write .",
		"format:check": "vp fmt --check .",
		"test": "vp test run",
		"test:legacy": "vp test run --mode legacy-test",
		"test:editor": "npm run sync && vp test run tests/editor",
		"emulate:webkit": "node tests/webkit.js",
		"prepare": "vp config && effect-language-service patch && effect-tsgo patch --typescript --oxlint && npm run sync",
		"check:types": "npm run sync && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.app.json",
		"effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.app.json",
		"sync": "svelte-kit sync",
		"check:asset-dump": "dotnet build tools/xnbhack/tests/WorkspaceTests.csproj",
		"postinstall": "patch-package --error-on-fail",
		"game-data:generate": "dotnet run --project tools/game-data -- generate",
		"test:game-data": "node tools/game-data/tests/prepare.mjs && node node_modules/@typescript/native/bin/tsc --noEmit -p tools/game-data/tsconfig.json && node --test tools/game-data/tests/*.node.ts",
		"check:game-data": "node tools/game-data/tests/prepare.mjs && node node_modules/@typescript/native/bin/tsc --noEmit -p tools/game-data/tsconfig.json",
		"test:browser:save-processing": "node --import tsx tools/verify-save-processing-browser.mjs",
		"lint": "vp lint",
		"check:tests": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.tests.json && svelte-check --tsgo --tsconfig ./tsconfig.tests.json",
		"check:tooling": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json",
		"effect:diagnostics:tests": "effect-tsgo diagnostics --project tsconfig.tests.json",
		"benchmark:toolchain": "node scripts/benchmark-toolchain.mjs"
	},
	"devDependencies": {
		"@effect/language-service": "0.87.5",
		"@effect/platform-node": "4.0.6",
		"@effect/tsgo": "0.68.1",
		"@effect/vitest": "4.0.6",
		"@sentry/sveltekit": "^11.12.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@thisux/sveltednd": "0.0.20",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.19.2",
		"@types/pako": "^2.0.4",
		"@types/wicg-file-system-access": "^2023.10.7",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-legacy": "^8.2.4",
		"@vitest/web-worker": "5.1.0",
		"comlink": "^4.4.2",
		"core-js": "3.51.0",
		"happy-dom": "^21.0.4",
		"idb": "^8.0.4",
		"image-dimensions": "^2.6.0",
		"pako": "^2.2.0",
		"patch-package": "^8.0.1",
		"string-similarity-js": "^2.1.4",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plugin-sveltekit-legacy": "^0.1.1",
		"vite-plus": "1.6.0",
		"vitest": "5.1.0",
		"vitest-indexeddb": "^0.0.2"
	},
	"optionalDependencies": {
		"playwright": "^1.65.0"
	},
	"type": "module",
	"engines": {
		"node": ">=24.11 <25"
	},
	"dependencies": {
		"@effect/platform-browser": "4.0.6",
		"bits-ui": "2.21.0",
		"effect": "4.0.6",
		"effect-atom-svelte": "0.4.1",
		"mutative": "2.0.2"
	},
	"allowScripts": {
		"core-js@3.51.0": true,
		"esbuild@0.28.2": true
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.6",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vitest": "5.1.0"
	}
}
