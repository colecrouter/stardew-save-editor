{
	// Component tests use application aliases and browser types, but also read
	// fixtures from disk under Node. Opt into those globals only in this scope.
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["$app/types", "wicg-file-system-access", "node"]
	},
	// Replacing include is intentional: imported app modules are still checked,
	// and the explicit declarations retain global save/reset types for tests.
	"include": [
		"../src/**/*.d.ts",
		"../codegen/**/*.d.ts",
		"../src/**/*.test.ts",
		"../src/**/*.test.js",
		"../src/**/*.test.svelte",
		"../src/**/*.spec.ts",
		"../src/**/*.spec.js",
		"../src/**/*.spec.svelte",
		"**/*.js",
		"**/*.ts",
		"**/*.svelte"
	],
	// The independent engine package owns its native Node and Effect test checks.
	"exclude": ["engine/**", "node_modules/**"]
}
