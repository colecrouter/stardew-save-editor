<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.1.0</Version>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<!-- Test assemblies and standalone maintenance scripts are separate programs. -->
	<ItemGroup>
		<Compile Remove="tests/**/*.cs;scripts/**/*.cs;workspace/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.14" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
	</ItemGroup>

</Project>
