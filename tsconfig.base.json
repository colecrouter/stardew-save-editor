{
	// Shared base TypeScript options used across the project
	// Extended by the app, component-test, Node-tooling and game-data scopes.
	// Each scope chooses ambient packages through types; default package lookup
	// lets Kit 3 resolve its generated node_modules/$app/types declarations.
	"compilerOptions": {
		"plugins": [
			{
				"name": "@effect/language-service",
				"includeSuggestionsInTsc": false,
				"ignoreEffectWarningsInTscExitCode": true,
				// Atom APIs are an explicitly adopted foundation; other diagnostics stay active.
				"diagnosticSeverity": { "unstableApiUsage": "off" }
			}
		],
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true
	}
}
