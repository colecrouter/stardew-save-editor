{
	// Shared base TypeScript options used across the project
	// Extended by the app, component-test, Node-tooling and game-data scopes.
	// Each scope chooses ambient packages through types; default package lookup
	// lets Kit 3 resolve its generated node_modules/$app/types declarations.
	"compilerOptions": {
		"plugins": [
			{
				"name": "@effect/language-service",
				"includeSuggestionsInTsc": false,
				"ignoreEffectWarningsInTscExitCode": true,
				// Atom APIs are an explicitly adopted foundation; other diagnostics stay active.
				"diagnosticSeverity": { "unstableApiUsage": "off" },
				// Mirror the deliberate XML API adoption in native/editor diagnostics.
				"overrides": [
					{
						"include": [
							"src/lib/xmlObject.ts",
							"src/lib/save-format/events.ts",
							"src/lib/save-format/xml.ts"
						],
						"options": {
							"diagnosticSeverity": { "experimentalApiUsage": "off" }
						}
					}
				]
			}
		],
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		// Subclass intent and switch control flow must remain explicit as APIs evolve.
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		// Optional fields distinguish omission from an explicit undefined value;
		// bracket access distinguishes extension dictionaries from declared fields.
		"exactOptionalPropertyTypes": true,
		"noPropertyAccessFromIndexSignature": true,
		"noFallthroughCasesInSwitch": true
	}
}
