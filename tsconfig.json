{
	// Editors discover this conventional filename, then follow the referenced
	// app, test and tooling projects to assign each file its intended globals.
	// Keep Kit's base explicit for its config validation, then inherit the app
	// options so this entry point retains the same generated alias metadata.
	"extends": ["$app/tsconfig", "./tsconfig.app.json"],
	// This solution owns no inputs: checks target the projects below directly,
	// without introducing composite builds or declaration output requirements.
	"files": [],
	"include": [],
	"references": [
		{ "path": "./tsconfig.app.json" },
		{ "path": "./tsconfig.tests.json" },
		{ "path": "./tsconfig.node.json" }
	]
}
