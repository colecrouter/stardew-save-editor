{
	// Browser automation and profiling run under Node while their evaluated
	// callbacks use browser APIs. This scope intentionally permits both without
	// supplying Node globals to production application components.
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["$app/types", "node", "wicg-file-system-access"]
	},
	// Codec fixture tests have their own game-data scope, checked by check:tooling.
	"include": ["src/**/*.d.ts", "tools/*.mjs", "tools/*.mts", "tools/*.d.ts"],
	"exclude": ["node_modules/**"]
}
